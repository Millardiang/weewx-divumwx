+        // or hasn't changed for a while (see stale_after in [BoltekLightning]).
+        setStatus(!b.stale);
+      }).catch(function(e){
+        console.warn('cardBoltekLightning: refresh failed --', e.message);
+        setStatus(false);
+      });
+  }
+  refresh();
+  setInterval(refresh, POLL_MS);
+})();
