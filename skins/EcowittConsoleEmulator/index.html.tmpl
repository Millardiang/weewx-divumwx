<!DOCTYPE html>
<!-- Copyright (c) Ian Millard 2026 -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="theme-color" content="#11185a">
  <title>$station.location</title>
  <link rel="manifest" href="manifest.json">
  <link rel="icon" href="icons/icon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@400;500;700&display=swap">
  <link rel="stylesheet" href="css/console.css?v=$ecce_version">
</head>
<body>
<div id="viewport">
 <div id="sizer">
  <div id="stage">

    <header id="hdr">
      <div id="hdr-l"><div id="hdr-left"></div><div id="hdr-leak" title="Leak sensors"></div></div>
      <div id="hdr-title">$station.location</div>
      <div id="hdr-clock"><span id="date"></span><span id="time"></span></div>
    </header>

    <section id="g-out"></section>
    <section id="g-wind"></section>

    <section id="rt-top">
      <div id="soil" class="tap" title="Tap for next channel"></div>
      <div id="light"></div>
    </section>
    <section id="g-ch" class="tap" title="Tap for next channel"></section>

    <section id="stats"></section>
    <section id="aq"></section>
    <section id="sky"></section>

    <section id="rain"></section>
    <section id="baro"></section>

    <i class="sep" id="sep-h1"></i>
    <i class="sep" id="sep-h2"></i>
    <i class="sep" id="sep-v"></i>

    <nav id="toolbar">
      <button data-act="graphs" title="Charts"></button>
      <button data-act="theme" title="Theme"></button>
      <button data-act="channel" title="Next channel"></button>
      <button data-act="sensors" title="Sensor batteries and signal"></button>
      <button data-act="refresh" title="Refresh now"></button>
      <button data-act="settings" title="Settings"></button>
    </nav>

  </div>
 </div>
</div>

<div id="toast" role="status" aria-live="polite"></div>

<!-- Panels (charts, radar, sensors, settings) fill the whole screen, outside the scaled dashboard -->
<div id="overlay" hidden>
  <div id="ov-panel">
    <div id="ov-head"><span id="ov-title"></span><button id="ov-close" title="Close">&times;</button></div>
    <div id="ov-tabs" hidden></div>
    <div id="ov-body"></div>
  </div>
</div>

<script>
window.ECCE_INITIAL = #include "ecce_payload.inc"
;
</script>
<script src="js/console.js?v=$ecce_version"></script>
</body>
</html>
