+  // Night side, shaded exactly as the Equal Earth map does: four nested
+  // circles round the antisolar point (sun 0, 6, 12 and 18 degrees below
+  // the horizon), each one a light wash, so twilight darkens in steps.
+  function drawNight(){
+    var RAD = Math.PI / 180, now = new Date();
+    var n = now.valueOf() / 864e5 + 2440587.5 - 2451545.0;
+    var L = (280.460 + 0.9856474 * n) % 360, g = ((357.528 + 0.9856003 * n) % 360) * RAD;
+    var lam = (L + 1.915 * Math.sin(g) + 0.020 * Math.sin(2 * g)) * RAD;
+    var eps = (23.439 - 0.0000004 * n) * RAD;
+    var ra = Math.atan2(Math.cos(eps) * Math.sin(lam), Math.cos(lam)) / RAD;
+    var dec = Math.asin(Math.sin(eps) * Math.sin(lam)) / RAD;
+    var gmst = (280.46061837 + 360.98564736629 * n) % 360;
+    var sunLon = ((ra - gmst) % 360 + 540) % 360 - 180;
+    var anti = [sunLon + 180, -dec];
+    [90, 96, 102, 108].forEach(function(z){
+      gNight.append('path').datum(d3.geoCircle().center(anti).radius(180 - z)())
+        .attr('class', 'eq-night').attr('d', path);
+    });
+  }
+  drawNight();
